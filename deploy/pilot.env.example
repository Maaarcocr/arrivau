# Example configuration only. Install outside the repository as /etc/arrivau/pilot.env.
# The API remains loopback-only. Terminate HTTPS at the same-host reverse proxy.
ARRIVAU_MODE=production
ARRIVAU_ADDR=127.0.0.1:8080
ARRIVAU_TLS_PROXY=1
ARRIVAU_DB_PATH=/var/lib/arrivau/pilot.sqlite3
ARRIVAU_AUTH_CONFIG=/etc/arrivau/auth.json
# Install the approved deploy/privacy.html first (see api/README.md).
# ARRIVAU_PRIVACY_NOTICE_PATH=/etc/arrivau/privacy.html
RUST_LOG=info
